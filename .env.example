# Upstream spell-data sources, copied into public/data/<id>/spells.json before `dev`/`build`
# by scripts/ensureData.ts (npm `predev`/`prebuild` hooks) when the destination file is missing.
# Both files are git-ignored derived artifacts; set these to the absolute path of the
# verbatim upstream JSON for each system.

SPELLS_PF1E_PATH=sample_data/pf1_spells.json
SPELLS_PF2E_PATH=sample_data/pf2_spells.json
SPELLS_DND5E_PATH=sample_data/dnd5e_spells.json

# Optional: AWS S3 deploy (npm run deploy) — see DEPLOY.md.
# Only needed if you're publishing to S3 from your fork; ignore if you deploy elsewhere
# (Netlify, Cloudflare Pages, GitHub Pages, etc.) or only run the app locally.
S3_BUCKET=your-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...   # only for temporary/STS credentials
