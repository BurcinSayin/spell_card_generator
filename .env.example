# Upstream spell-data sources, copied into public/data/<id>/spells.json before `dev`/`build`
# by scripts/ensureData.ts (npm `predev`/`prebuild` hooks) when the destination file is missing.
# Both files are git-ignored derived artifacts; set these to the absolute path of the
# verbatim upstream JSON for each system.

SPELLS_PF1E_PATH=sample_data/pf1_spells.json
SPELLS_PF2E_PATH=sample_data/pf2_spells.json
